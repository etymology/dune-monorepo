<Programs Use="Context">
<Program Use="Context" Name="state_1_ready" Class="Standard">
<Tags Use="Context">
<Tag Name="STATE1_IND" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read Only">
<Data Format="L5K">
<![CDATA[1]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="1"/>
</Data>
</Tag>
</Tags>
<Routines Use="Context">
<Routine Use="Target" Name="main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(INIT_DONE)CMP(STATE=1)OTE(STATE1_IND);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(STATE1_IND)CMP(MOVE_TYPE=1)MOV(2,STATE_REQUEST);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(STATE1_IND)CMP(MOVE_TYPE=2)MOV(3,STATE_REQUEST);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(STATE1_IND)CMP(MOVE_TYPE=4)MOV(5,STATE_REQUEST);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(STATE1_IND)CMP(MOVE_TYPE=5)MOV(6,STATE_REQUEST);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(STATE1_IND)CMP(MOVE_TYPE=8)MOV(9,STATE_REQUEST);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(STATE1_IND)CMP(MOVE_TYPE=9)MOV(0,NEXTSTATE);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(STATE1_IND)CMP(STATE_REQUEST_ID<>STATE_REQUEST_ACK)MOV(STATE_REQUEST_ID,STATE_REQUEST_ACK)MOV(0,STATE_REQUEST_RESULT)MOV(0,STATE_FAULT_FLAGS);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(STATE1_IND)CMP(STATE_REQUEST<>0)MOV(1,STATE_REQUEST_RESULT)MOV(STATE_REQUEST,NEXTSTATE);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
