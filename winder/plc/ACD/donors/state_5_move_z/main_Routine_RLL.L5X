<Routines Use="Context">
<Routine Use="Target" Name="main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[XIC(Z_FIXED_LATCHED) EQU(ACTUATOR_POS,2) ,XIO(Z_FIXED_LATCHED) ]OTE(no_latch_collision);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(X_XFER_OK) ,XIC(Y_XFER_OK) ]OTE(no_apa_collision);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(X_XFER_OK) [LIM(400,X_axis.ActualPosition,500) [XIC(support_collision_window_bttm) XIO(FRAME_LOC_HD_BTM) ,XIC(support_collision_window_mid) XIO(FRAME_LOC_HD_MID) ,XIC(support_collision_window_top) XIO(FRAME_LOC_HD_TOP) ] ,LIM(7100,X_axis.ActualPosition,7200) [XIC(support_collision_window_bttm) XIO(FRAME_LOC_FT_BTM) ,XIC(support_collision_window_mid) XIO(FRAME_LOC_FT_MID) ,XIC(support_collision_window_top) XIO(FRAME_LOC_FT_TOP) ] ,XIO(support_collision_window_bttm) XIO(support_collision_window_mid) XIO(support_collision_window_top) ] ,XIC(Y_XFER_OK) ]OTE(no_supports_collision);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(no_latch_collision)XIC(no_supports_collision)XIC(no_apa_collision)OTE(MASTER_Z_GO);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[CMP(STATE=4)MOV(1,NEXTSTATE);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[CMP(STATE=5)XIC(Z_FIXED_LATCHED)XIC(LATCH_ACTUATOR_HOMED)CMP(ACTUATOR_POS<>2)CPT(ERROR_CODE,5004)CPT(NEXTSTATE,10);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[CMP(STATE=5)XIC(Z_axis.PhysicalAxisFault)CPT(ERROR_CODE,5002)CPT(NEXTSTATE,10);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[CMP(STATE=5)XIO(MASTER_Z_GO)CPT(ERROR_CODE,5001)CPT(NEXTSTATE,10);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(MASTER_Z_GO)CMP(ERROR_CODE=5001)CPT(ERROR_CODE,0);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[CMP(STATE=5)XIC(MASTER_Z_GO)[XIC(tension_stable_timer.DN) ,XIO(check_tension_stable) ,XIO(TENSION_CONTROL_OK) ,XIC(Z_FIXED_LATCHED) ]OTE(STATE5_IND);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(STATE5_IND)XIO(Z_axis.DriveEnableStatus)MSO(Z_axis,z_axis_mso);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(STATE5_IND)XIC(Z_axis.DriveEnableStatus)XIO(Z_FIXED_LATCHED)MAM(Z_axis,z_axis_main_move,0,Z_POSITION,Z_SPEED,Units per sec,Z_ACCELERATION,Units per sec2,Z_DECELLERATION,Units per sec2,S-Curve,z_accel_jerk,z_decel_jerk,Units per sec3,Disabled,Programmed,0,None,0,0);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(STATE5_IND)XIC(Z_axis.DriveEnableStatus)XIC(Z_FIXED_LATCHED)MAM(Z_axis,z_axis_fast_move,0,Z_POSITION,2000,Units per sec,10000,Units per sec2,10000,Units per sec2,S-Curve,15000,12000,Units per sec3,Disabled,Programmed,0,None,0,0);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(Z_axis.MoveStatus)CMP(STATE_REQUEST=14)CPT(NEXTSTATE,14);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIO(ALL_EOT_GOOD)XIC(Z_axis.MoveStatus)MAS(Z_axis,eot_stop,Jog,Yes,2000,Units per sec2,No,100,% of Time);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(eot_stop.PC)CPT(ERROR_CODE,5005)CPT(NEXTSTATE,11)MOV(0,eot_stop.FLAGS);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[CMP(STATE=5)CMP(ABS(Z_axis.ActualPosition-Z_POSITION)<0.1)OSR(oneshotob[0],z_move_success);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(z_move_success)CPT(STATE_REQUEST,0)CPT(MOVE_TYPE,0)CPT(NEXTSTATE,1)MOV(0,z_axis_main_move.FLAGS)MOV(0,z_axis_fast_move.FLAGS);]]>
</Text>
</Rung>
</RLLContent>
