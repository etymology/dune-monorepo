routine state_1_ready/main

uses INIT_DONE, MOVE_TYPE, NEXTSTATE, STATE, STATE_FAULT_FLAGS, STATE_REQUEST, STATE_REQUEST_ACK  # controller scope
uses STATE_REQUEST_ID, STATE_REQUEST_RESULT  # controller scope
uses STATE1_IND  # program scope

# PENDING EDIT in Studio
raw `XIC(INIT_DONE)EQU(STATE,1)OTE(STATE1_IND)`

# PENDING EDIT in Studio
raw `XIC(STATE1_IND)EQU(MOVE_TYPE,1)MOV(2,STATE_REQUEST)`

# PENDING EDIT in Studio
raw `XIC(STATE1_IND)EQU(MOVE_TYPE,2)MOV(3,STATE_REQUEST)`

# PENDING EDIT in Studio
raw `XIC(STATE1_IND)EQU(MOVE_TYPE,4)MOV(5,STATE_REQUEST)`

# PENDING EDIT in Studio
raw `XIC(STATE1_IND)EQU(MOVE_TYPE,5)MOV(6,STATE_REQUEST)`

# PENDING EDIT in Studio
raw `XIC(STATE1_IND)EQU(MOVE_TYPE,8)MOV(9,STATE_REQUEST)`

# PENDING EDIT in Studio
raw `XIC(STATE1_IND)NEQ(STATE_REQUEST_ID,STATE_REQUEST_ACK)MOV(STATE_REQUEST_ID,STATE_REQUEST_ACK)MOV(0,STATE_REQUEST_RESULT)MOV(0,STATE_FAULT_FLAGS)`

# PENDING EDIT in Studio
raw `XIC(STATE1_IND)NEQ(STATE_REQUEST,0)MOV(1,STATE_REQUEST_RESULT)MOV(STATE_REQUEST,NEXTSTATE)`
