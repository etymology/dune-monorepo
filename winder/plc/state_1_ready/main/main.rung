routine state_1_ready/main

uses INIT_DONE, MOVE_TYPE, NEXTSTATE, STATE, STATE_FAULT_FLAGS, STATE_REQUEST, STATE_REQUEST_ACK  # controller scope
uses STATE_REQUEST_ID, STATE_REQUEST_RESULT  # controller scope
uses STATE1_IND  # program scope

STATE1_IND = INIT_DONE and STATE == 1

STATE_REQUEST = 2 when STATE1_IND and MOVE_TYPE == 1

STATE_REQUEST = 3 when STATE1_IND and MOVE_TYPE == 2

STATE_REQUEST = 5 when STATE1_IND and MOVE_TYPE == 4

STATE_REQUEST = 6 when STATE1_IND and MOVE_TYPE == 5

STATE_REQUEST = 9 when STATE1_IND and MOVE_TYPE == 8

NEXTSTATE = 0 when STATE1_IND and MOVE_TYPE == 9

raw `XIC(STATE1_IND)CMP(STATE_REQUEST_ID<>STATE_REQUEST_ACK)MOV(STATE_REQUEST_ID,STATE_REQUEST_ACK)MOV(0,STATE_REQUEST_RESULT)MOV(0,STATE_FAULT_FLAGS)`

when STATE1_IND and STATE_REQUEST != 0:
    STATE_REQUEST_RESULT = 1
    NEXTSTATE = STATE_REQUEST
