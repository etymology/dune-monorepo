routine state_11_eot_trip/main

uses AbortQueue, ALL_EOT_GOOD, ERROR_CODE, MINUS_X_EOT, MINUS_Y_EOT, MOVE_TYPE, NEXTSTATE  # controller scope
uses PLUS_X_EOT, PLUS_Y_EOT, STATE, STATE_REQUEST, X_axis, X_Y, xz, Y_axis, yz, Z_axis, Z_EOT  # controller scope
uses eot_axes_enabled, eot_entry_ob, eot_entry_sb, eot_manual_ob, eot_manual_sb  # program scope
uses eot_mso_start_ob, eot_mso_start_sb, eot_mso_x, eot_mso_y, eot_mso_z, eot_recover_ready  # program scope
uses eot_recovery_done, eot_stop_x, eot_stop_xy, eot_stop_xz, eot_stop_y, eot_stop_yz  # program scope
uses eot_stop_z, eot_stops_done, STATE11_IND, x_minus_clear_ob, x_minus_clear_sb  # program scope
uses x_minus_cleared, x_minus_jog_active, x_minus_jog_cmd, x_minus_jog_start_ob  # program scope
uses x_minus_jog_start_sb, x_minus_jog_stop, x_minus_jog_timer, x_minus_mrp_cmd  # program scope
uses x_minus_mrp_start_ob, x_minus_mrp_start_sb, x_minus_stop_req, x_minus_timeout, x_minus_trip  # program scope
uses x_plus_clear_ob, x_plus_clear_sb, x_plus_jog_active, x_plus_jog_cmd, x_plus_jog_start_ob  # program scope
uses x_plus_jog_start_sb, x_plus_jog_stop, x_plus_jog_timer, x_plus_stop_req, x_plus_timeout  # program scope
uses x_plus_trip, y_minus_clear_ob, y_minus_clear_sb, y_minus_cleared, y_minus_jog_active  # program scope
uses y_minus_jog_cmd, y_minus_jog_start_ob, y_minus_jog_start_sb, y_minus_jog_stop  # program scope
uses y_minus_jog_timer, y_minus_mrp_cmd, y_minus_mrp_start_ob, y_minus_mrp_start_sb  # program scope
uses y_minus_stop_req, y_minus_timeout, y_minus_trip, y_plus_clear_ob, y_plus_clear_sb  # program scope
uses y_plus_jog_active, y_plus_jog_cmd, y_plus_jog_start_ob, y_plus_jog_start_sb  # program scope
uses y_plus_jog_stop, y_plus_jog_timer, y_plus_stop_req, y_plus_timeout, y_plus_trip  # program scope
uses z_recover_started, z_trip, z_zero_cmd, z_zero_start_ob, z_zero_start_sb  # program scope

when not ALL_EOT_GOOD:
    NEXTSTATE = 11
    STATE_REQUEST = 0

STATE11_IND = STATE == 11

OSR(eot_entry_sb, eot_entry_ob) when STATE11_IND

OSR(eot_manual_sb, eot_manual_ob) when STATE11_IND and STATE_REQUEST == 11

when eot_entry_ob or eot_manual_ob:
    eot_stop_xy.FLAGS = 0
    eot_stop_xz.FLAGS = 0
    eot_stop_x.FLAGS = 0
    eot_stop_y.FLAGS = 0
    eot_stop_z.FLAGS = 0
    x_minus_jog_cmd.FLAGS = 0
    x_minus_jog_stop.FLAGS = 0
    x_minus_mrp_cmd.FLAGS = 0
    x_plus_jog_cmd.FLAGS = 0
    x_plus_jog_stop.FLAGS = 0
    y_minus_jog_cmd.FLAGS = 0
    y_minus_jog_stop.FLAGS = 0
    y_minus_mrp_cmd.FLAGS = 0
    y_plus_jog_cmd.FLAGS = 0
    y_plus_jog_stop.FLAGS = 0
    z_zero_cmd.FLAGS = 0
    eot_mso_x.FLAGS = 0
    eot_mso_y.FLAGS = 0
    eot_mso_z.FLAGS = 0
    reset x_minus_jog_timer
    reset x_plus_jog_timer
    reset y_minus_jog_timer
    reset y_plus_jog_timer
    unlatch x_minus_trip
    unlatch x_plus_trip
    unlatch y_minus_trip
    unlatch y_plus_trip
    unlatch z_trip
    unlatch x_minus_jog_active
    unlatch x_minus_stop_req
    unlatch x_minus_cleared
    unlatch x_minus_timeout
    unlatch x_plus_jog_active
    unlatch x_plus_stop_req
    unlatch x_plus_timeout
    unlatch y_minus_jog_active
    unlatch y_minus_stop_req
    unlatch y_minus_cleared
    unlatch y_minus_timeout
    unlatch y_plus_jog_active
    unlatch y_plus_stop_req
    unlatch y_plus_timeout
    unlatch z_recover_started
    x_minus_jog_timer.PRE = 10000
    x_plus_jog_timer.PRE = 10000
    y_minus_jog_timer.PRE = 10000
    y_plus_jog_timer.PRE = 10000
    MCS(X_Y, eot_stop_xy, All, Yes, 10000, "Units per sec2", Yes, 10000, "Units per sec3")
    MCS(xz, eot_stop_xz, All, Yes, 10000, "Units per sec2", Yes, 10000, "Units per sec3")
    MCS(yz, eot_stop_yz, All, Yes, 10000, "Units per sec2", Yes, 10000, "Units per sec3")
    MAS(X_axis, eot_stop_x, All, Yes, 10000, "Units per sec2", Yes, 10000, "Units per sec3")
    MAS(Y_axis, eot_stop_y, All, Yes, 10000, "Units per sec2", Yes, 10000, "Units per sec3")
    MAS(Z_axis, eot_stop_z, All, Yes, 10000, "Units per sec2", Yes, 10000, "Units per sec3")

AbortQueue = STATE11_IND

when STATE11_IND:
    MOVE_TYPE = 0
    STATE_REQUEST = 0

latch x_minus_trip when STATE11_IND and not MINUS_X_EOT

latch x_plus_trip when STATE11_IND and not PLUS_X_EOT

latch y_minus_trip when STATE11_IND and not MINUS_Y_EOT

latch y_plus_trip when STATE11_IND and not PLUS_Y_EOT

latch z_trip when STATE11_IND and not Z_EOT

eot_stops_done = STATE11_IND and eot_stop_xy.DN and eot_stop_xz.DN and eot_stop_x.DN and eot_stop_y.DN and eot_stop_z.DN

on rising eot_stops_done and X_axis.MotionStatus == 0 and Y_axis.MotionStatus == 0 using eot_mso_start_sb, eot_mso_start_ob:
    servo_on X_axis using eot_mso_x
    servo_on Y_axis using eot_mso_y
    servo_on Z_axis using eot_mso_z

eot_axes_enabled = eot_mso_x.DN and eot_mso_y.DN and eot_mso_z.DN

eot_recover_ready = STATE11_IND and eot_stops_done and eot_axes_enabled and not X_axis.MoveStatus and not Y_axis.MoveStatus and not Z_axis.MoveStatus and not X_axis.StoppingStatus and not Y_axis.StoppingStatus and not Z_axis.StoppingStatus

on rising STATE11_IND and eot_recover_ready and x_minus_trip and not MINUS_X_EOT and not X_axis.StoppingStatus and not x_minus_jog_active and not x_minus_timeout and not x_minus_jog_cmd.IP and not x_plus_trip and not x_plus_stop_req using x_minus_jog_start_sb, x_minus_jog_start_ob:
    latch x_minus_jog_active
    MAJ(X_axis, x_minus_jog_cmd, 0, 1, "Units per sec", 1, "Units per sec2", 1, "Units per sec2", Trapezoidal, 100, 100, "% of Time", Disabled, Programmed, 0, None)

start_timer x_minus_jog_timer when x_minus_jog_active  # preset 10000 ms

OSR(x_minus_clear_sb, x_minus_clear_ob) when x_minus_trip and x_minus_jog_active and not x_minus_timeout and MINUS_X_EOT

latch x_minus_cleared when x_minus_clear_ob

when x_minus_clear_ob or x_minus_jog_active and x_minus_jog_timer.DN:
    latch x_minus_stop_req
    unlatch x_minus_jog_active

latch x_minus_timeout when x_minus_jog_active and x_minus_jog_timer.DN

MAS(X_axis, x_minus_jog_stop, All, Yes, 1000, "Units per sec2", Yes, 1000, "Units per sec3") when x_minus_stop_req

unlatch x_minus_stop_req when x_minus_stop_req and x_minus_jog_stop.DN

on rising x_minus_cleared and not X_axis.StoppingStatus and x_minus_jog_stop.DN and not x_minus_mrp_cmd.IP using x_minus_mrp_start_sb, x_minus_mrp_start_ob:
    MRP(X_axis, x_minus_mrp_cmd, Absolute, Actual, -10)

when x_minus_mrp_cmd.DN:
    unlatch x_minus_cleared
    unlatch x_minus_trip

on rising STATE11_IND and eot_recover_ready and x_plus_trip and not PLUS_X_EOT and not X_axis.StoppingStatus and not x_plus_jog_active and not x_plus_timeout and not x_plus_jog_cmd.IP and not x_minus_trip and not x_minus_stop_req and not x_minus_cleared using x_plus_jog_start_sb, x_plus_jog_start_ob:
    latch x_plus_jog_active
    MAJ(X_axis, x_plus_jog_cmd, 1, 1, "Units per sec", 1, "Units per sec2", 1, "Units per sec2", Trapezoidal, 100, 100, "% of Time", Disabled, Programmed, 0, None)

start_timer x_plus_jog_timer when x_plus_jog_active  # preset 10000 ms

OSR(x_plus_clear_sb, x_plus_clear_ob) when x_plus_trip and x_plus_jog_active and not x_plus_timeout and PLUS_X_EOT

when x_plus_clear_ob or x_plus_jog_active and x_plus_jog_timer.DN:
    latch x_plus_stop_req
    unlatch x_plus_jog_active

latch x_plus_timeout when x_plus_jog_active and x_plus_jog_timer.DN

MAS(X_axis, x_plus_jog_stop, All, Yes, 1000, "Units per sec2", Yes, 1000, "Units per sec3") when x_plus_stop_req

raw `XIC(x_plus_stop_req)XIC(x_plus_jog_stop.DN)OTU(x_plus_stop_req)OTU(x_plus_trip)`

on rising STATE11_IND and eot_recover_ready and y_minus_trip and not MINUS_Y_EOT and not Y_axis.StoppingStatus and not y_minus_jog_active and not y_minus_timeout and not y_minus_jog_cmd.IP and not y_plus_trip and not y_plus_stop_req using y_minus_jog_start_sb, y_minus_jog_start_ob:
    latch y_minus_jog_active
    MAJ(Y_axis, y_minus_jog_cmd, 0, 1, "Units per sec", 1, "Units per sec2", 1, "Units per sec2", Trapezoidal, 100, 100, "% of Time", Disabled, Programmed, 0, None)

start_timer y_minus_jog_timer when y_minus_jog_active  # preset 10000 ms

OSR(y_minus_clear_sb, y_minus_clear_ob) when y_minus_trip and y_minus_jog_active and not y_minus_timeout and MINUS_Y_EOT

latch y_minus_cleared when y_minus_clear_ob

when y_minus_clear_ob or y_minus_jog_active and y_minus_jog_timer.DN:
    latch y_minus_stop_req
    unlatch y_minus_jog_active

latch y_minus_timeout when y_minus_jog_active and y_minus_jog_timer.DN

MAS(Y_axis, y_minus_jog_stop, All, Yes, 1000, "Units per sec2", Yes, 1000, "Units per sec3") when y_minus_stop_req

unlatch y_minus_stop_req when y_minus_stop_req and y_minus_jog_stop.DN

on rising y_minus_cleared and not Y_axis.StoppingStatus and y_minus_jog_stop.DN and not y_minus_mrp_cmd.IP using y_minus_mrp_start_sb, y_minus_mrp_start_ob:
    MRP(Y_axis, y_minus_mrp_cmd, Absolute, Actual, -10)

when y_minus_mrp_cmd.DN:
    unlatch y_minus_cleared
    unlatch y_minus_trip

on rising STATE11_IND and eot_recover_ready and y_plus_trip and not PLUS_Y_EOT and not Y_axis.StoppingStatus and not y_plus_jog_active and not y_plus_timeout and not y_plus_jog_cmd.IP and not y_minus_trip and not y_minus_stop_req and not y_minus_cleared using y_plus_jog_start_sb, y_plus_jog_start_ob:
    latch y_plus_jog_active
    MAJ(Y_axis, y_plus_jog_cmd, 1, 1, "Units per sec", 1, "Units per sec2", 1, "Units per sec2", Trapezoidal, 100, 100, "% of Time", Disabled, Programmed, 0, None)

start_timer y_plus_jog_timer when y_plus_jog_active  # preset 10000 ms

OSR(y_plus_clear_sb, y_plus_clear_ob) when y_plus_trip and y_plus_jog_active and not y_plus_timeout and PLUS_Y_EOT

when y_plus_clear_ob or y_plus_jog_active and y_plus_jog_timer.DN:
    latch y_plus_stop_req
    unlatch y_plus_jog_active

latch y_plus_timeout when y_plus_jog_active and y_plus_jog_timer.DN

MAS(Y_axis, y_plus_jog_stop, All, Yes, 1000, "Units per sec2", Yes, 1000, "Units per sec3") when y_plus_stop_req

raw `XIC(y_plus_stop_req)XIC(y_plus_jog_stop.DN)OTU(y_plus_stop_req)OTU(y_plus_trip)`

on rising STATE11_IND and eot_recover_ready and z_trip and not Z_EOT and not Z_axis.StoppingStatus and not z_recover_started and not z_zero_cmd.IP using z_zero_start_sb, z_zero_start_ob:
    latch z_recover_started
    move_axis Z_axis using z_zero_cmd:
        type       = absolute
        position   = 0
        speed      = 1 units/s
        accel      = 1 units/s2
        decel      = 1 units/s2
        profile    = trapezoidal
        jerk       = 100
        jerk_units = "% of Time"
        merge      = Disabled

unlatch z_trip when z_zero_cmd.DN

eot_recovery_done = STATE11_IND and not x_minus_trip and not x_plus_trip and not y_minus_trip and not y_plus_trip and not z_trip and PLUS_X_EOT and MINUS_X_EOT and PLUS_Y_EOT and MINUS_Y_EOT and Z_EOT and not x_minus_jog_active and not x_minus_stop_req and not x_minus_cleared and not x_plus_jog_active and not x_plus_stop_req and not y_minus_jog_active and not y_minus_stop_req and not y_minus_cleared and not y_plus_jog_active and not y_plus_stop_req and not x_minus_jog_cmd.IP and not x_plus_jog_cmd.IP and not x_minus_mrp_cmd.IP and not y_minus_jog_cmd.IP and not y_plus_jog_cmd.IP and not y_minus_mrp_cmd.IP and not z_zero_cmd.IP

when ALL_EOT_GOOD and STATE == 11 or eot_recovery_done:
    ERROR_CODE = 0
    STATE_REQUEST = 0
    NEXTSTATE = 1
