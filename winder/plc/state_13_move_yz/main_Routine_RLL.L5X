<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(STATE13_IND)XIC(X_XFER_OK)XIO(yz_main_move.IP)MCLM(yz,yz_main_move,0,yz_position_target,yz_speed,Units per sec,1000,Units per sec2,1000,Units per sec2,S-Curve,1000,1000,Units per sec3,0,Disabled,Programmed,50,0,None,0,0);]]>
