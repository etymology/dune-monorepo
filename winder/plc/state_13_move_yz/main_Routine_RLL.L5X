<Text>
<![CDATA[XIC(STATE13_IND)CMP(ABS(Y_axis.ActualPosition-yz_position_target[0])<0.1)CMP(ABS(Z_axis.ActualPosition-yz_position_target[1])<0.1)MOV(0,STATE_REQUEST)CPT(NEXTSTATE,1);]]>
