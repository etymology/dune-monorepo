routine state_12_move_xz/main

uses ERROR_CODE, NEXTSTATE, STATE, STATE_REQUEST, X_axis, X_Y, xz, xz_position_target, xz_speed  # controller scope
uses Y_axis, Y_XFER_OK, Z_axis, Z_RETRACTED  # controller scope
uses STATE12_IND, xy_stop, xz_main_move, xz_stop, y_axis_stop  # program scope

# PENDING EDIT in Studio
raw `CMP(STATE=12)OTE(STATE12_IND)`

# PENDING EDIT in Studio
raw `XIC(STATE12_IND)XIO(Y_XFER_OK)CPT(ERROR_CODE,5003)MOV(0,STATE_REQUEST)CPT(NEXTSTATE,10)`

# PENDING EDIT in Studio
raw `XIC(STATE12_IND)XIC(Y_XFER_OK)XIO(xz_main_move.IP)MCLM(xz,xz_main_move,0,xz_position_target,xz_speed,Units per sec,1000,Units per sec2,1000,Units per sec2,S-Curve,1000,1000,Units per sec3,0,Disabled,Programmed,50,0,None,0,0)`

# PENDING EDIT in Studio
raw `XIO(Y_XFER_OK)XIC(xz_main_move.IP)MCS(X_Y,xy_stop,All,Yes,4000,Units per sec2,Yes,2000,Units per sec3)MCS(xz,xz_stop,All,Yes,4000,Units per sec2,Yes,200,Units per sec3)MOV(0,STATE_REQUEST)CPT(ERROR_CODE,5003)CPT(NEXTSTATE,10)`

# PENDING EDIT in Studio
raw `XIC(STATE12_IND)XIC(xz_main_move.ER)MOV(0,STATE_REQUEST)CPT(ERROR_CODE,5003)CPT(NEXTSTATE,10)`

# PENDING EDIT in Studio
raw `XIC(STATE12_IND)CMP(ABS(X_axis.ActualPosition-xz_position_target[0])<0.1)CMP(ABS(Z_axis.ActualPosition-xz_position_target[1])<0.1)MOV(0,STATE_REQUEST)CPT(NEXTSTATE,1)`

# PENDING EDIT in Studio
raw `XIC(Y_axis.MoveStatus)XIO(Z_RETRACTED)MAS(Y_axis,y_axis_stop,All,Yes,4000,Units per sec2,Yes,4000,Units per sec3)`
