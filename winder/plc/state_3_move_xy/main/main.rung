routine state_3_move_xy/main

uses accel_xy, ALL_EOT_GOOD, APA_IS_VERTICAL, check_tension_stable, ERROR_CODE, gamma, J  # controller scope
uses MAX_TOLERABLE_Z, MCCD_X_Y_Axis1, MOVE_TYPE, NEXTSTATE, speed_regulator_switch, STATE  # controller scope
uses STATE_REQUEST, TENSION_CONTROL_OK, TENSION_ON_SWITCH, tension_stable_timer, v_0, v_x_max  # controller scope
uses v_xyz, v_y_max, X_axis, X_POSITION, X_Y, XY_ACCELERATION, XY_DECELERATION, XY_SPEED  # controller scope
uses XY_SPEED_REQ, Y_axis, Y_POSITION, Z_axis, Z_RETRACTED  # controller scope
uses auto_edge_0_sb, dx, dy, eot_triggered, k, main_xy_move, main_xy_move_completed  # program scope
uses main_xy_move_completed_sb, move_xy_entry_ob, move_xy_entry_sb, near_ending  # program scope
uses speed_regulator_off_ob, speed_regulator_off_sb, starting_x, starting_y, STATE3_IND  # program scope
uses stopping_distance, stopping_ratio, trigger_xy_move, v_max, x_axis_mso, x_dist_to_target  # program scope
uses x_time, xy_accel_jerk, xy_axes_servoed_on_ob, xy_axes_servoed_on_sb, xy_decel_jerk  # program scope
uses xy_dist_to_target, xy_eot_stop_control, xy_move_error_ob, xy_move_error_sb  # program scope
uses xy_move_trigger_sb, xy_pre_move, y_axis_mso, y_dist_to_target, y_time, z_axis_mso  # program scope
uses z_axis_pre_xy_retract  # program scope

# PENDING EDIT in Studio
raw `EQU(STATE,2)MOV(1,NEXTSTATE)`

xy_pre_move = not main_xy_move.IP and STATE == 3 and (tension_stable_timer.DN or not check_tension_stable or not TENSION_ON_SWITCH)

# PENDING EDIT in Studio
raw `XIC(xy_pre_move)[XIO(Z_RETRACTED),GEQ(Z_axis.ActualPosition,MAX_TOLERABLE_Z)]MOV(3001,ERROR_CODE)MOV(10,NEXTSTATE)`

# PENDING EDIT in Studio
raw `XIC(xy_pre_move)XIO(APA_IS_VERTICAL)MOV(3005,ERROR_CODE)MOV(10,NEXTSTATE)`

# PENDING EDIT in Studio
raw `XIC(xy_pre_move)XIC(Z_RETRACTED)OTE(STATE3_IND)`

# PENDING EDIT in Studio
raw `XIC(STATE3_IND)OSR(move_xy_entry_sb,move_xy_entry_ob)`

# PENDING EDIT in Studio
raw `XIC(STATE3_IND)XIC(X_Y.PhysicalAxisFault)MOV(3002,ERROR_CODE)`

# PENDING EDIT in Studio
raw `XIC(STATE3_IND)[XIC(X_axis.SafeTorqueOffInhibit),XIC(Y_axis.SafeTorqueOffInhibit)]MOV(3004,ERROR_CODE)`

# PENDING EDIT in Studio
raw `XIC(STATE3_IND)[XIC(X_Y.PhysicalAxisFault),XIC(X_axis.SafeTorqueOffInhibit),XIC(Y_axis.SafeTorqueOffInhibit)]MOV(10,NEXTSTATE)`

# PENDING EDIT in Studio
raw `XIC(move_xy_entry_ob)MSO(X_axis,x_axis_mso)MSO(Y_axis,y_axis_mso)MSO(Z_axis,z_axis_mso)`

# PENDING EDIT in Studio
raw `XIC(z_axis_mso.DN)MOV(0,z_axis_pre_xy_retract.FLAGS)MAM(Z_axis,z_axis_pre_xy_retract,0,0,1000,Units per sec,10000,Units per sec2,10000,Units per sec2,S-Curve,10000,10000,Units per sec3,0,0,0,0,0,0)MOV(0,z_axis_mso.FLAGS)`

# PENDING EDIT in Studio
raw `XIC(x_axis_mso.DN)XIC(y_axis_mso.DN)OSR(xy_axes_servoed_on_sb,xy_axes_servoed_on_ob)`

# PENDING EDIT in Studio
raw `[XIC(xy_axes_servoed_on_ob),XIC(x_axis_mso.DN)XIC(y_axis_mso.DN)XIC(move_xy_entry_ob)]OSR(xy_move_trigger_sb,trigger_xy_move)`

# PENDING EDIT in Studio
raw `XIC(trigger_xy_move)MOV(X_axis.ActualPosition,starting_x)MOV(Y_axis.ActualPosition,starting_y)`

# PENDING EDIT in Studio
raw `XIC(trigger_xy_move)CPT(dx,ABS(starting_x-X_POSITION))CPT(dy,ABS(starting_y-Y_POSITION))CPT(x_time,v_x_max/dx)CPT(y_time,v_y_max/dy)`

# PENDING EDIT in Studio
raw `XIC(trigger_xy_move)LES(x_time,y_time)MOV(x_time,k)`

# PENDING EDIT in Studio
raw `XIC(trigger_xy_move)LEQ(y_time,x_time)MOV(y_time,k)`

# PENDING EDIT in Studio
raw `XIC(trigger_xy_move)CPT(v_max,k*SQR(dx*dx+dy*dy))`

# PENDING EDIT in Studio
raw `XIC(trigger_xy_move)LES(v_max,XY_SPEED)MOV(v_max,XY_SPEED_REQ)`

# PENDING EDIT in Studio
raw `XIC(trigger_xy_move)LEQ(XY_SPEED,v_max)MOV(XY_SPEED,XY_SPEED_REQ)`

# PENDING EDIT in Studio
raw `CPT(x_dist_to_target,X_axis.ActualPosition-X_POSITION)CPT(y_dist_to_target,Y_axis.ActualPosition-Y_POSITION)CPT(xy_dist_to_target,SQR(x_dist_to_target*x_dist_to_target+y_dist_to_target*y_dist_to_target))`

# PENDING EDIT in Studio
raw `MOV(xy_decel_jerk,J)MOV(v_xyz,v_0)CPT(gamma,SQR(accel_xy*accel_xy+4*J*v_0))CPT(stopping_distance,(accel_xy+gamma)*(accel_xy+gamma)*(accel_xy+gamma)/(6*J*J))`

# PENDING EDIT in Studio
raw `LES(xy_dist_to_target,stopping_distance)OTE(near_ending)`

# PENDING EDIT in Studio
raw `XIC(STATE3_IND)CPT(stopping_ratio,stopping_distance/xy_dist_to_target)`

# PENDING EDIT in Studio
raw `XIC(TENSION_CONTROL_OK)XIC(speed_regulator_switch)JSR(xy_speed_regulator,0)`

# PENDING EDIT in Studio
raw `[XIO(TENSION_CONTROL_OK),XIC(TENSION_CONTROL_OK)XIO(speed_regulator_switch)]XIC(trigger_xy_move)MCLM(X_Y,main_xy_move,0,X_POSITION,XY_SPEED_REQ,Units per sec,XY_ACCELERATION,Units per sec2,XY_DECELERATION,Units per sec2,S-Curve,500,500,Units per sec3,0,Disabled,Programmed,50,0,None,0,0)`

# PENDING EDIT in Studio
raw `XIC(speed_regulator_switch)OSF(speed_regulator_off_sb,speed_regulator_off_ob)`

# PENDING EDIT in Studio
raw `XIC(speed_regulator_off_ob)XIO(near_ending)MCCD(X_Y,MCCD_X_Y_Axis1,Coordinated Move,Yes,XY_SPEED_REQ,Units per sec,Yes,XY_ACCELERATION,Units per sec2,Yes,XY_DECELERATION,Units per sec2,No,xy_accel_jerk,No,xy_decel_jerk,Units per sec3,Active Motion)`

# PENDING EDIT in Studio
raw `[XIC(main_xy_move.PC),XIC(main_xy_move.ER)CMP(X_POSITION-X_axis.ActualPosition<0.1)CMP(Y_POSITION-Y_axis.ActualPosition<0.1)]OSR(main_xy_move_completed_sb,main_xy_move_completed)`

# PENDING EDIT in Studio
raw `XIC(main_xy_move.ER)CMP(X_POSITION-X_axis.ActualPosition>0.1)CMP(Y_POSITION-Y_axis.ActualPosition>0.1)MOV(3005,ERROR_CODE)MOV(10,NEXTSTATE)MOV(0,MOVE_TYPE)MOV(0,STATE_REQUEST)MOV(0,main_xy_move.FLAGS)`

# PENDING EDIT in Studio
raw `XIC(main_xy_move.ER)OSR(xy_move_error_sb,xy_move_error_ob)`

# PENDING EDIT in Studio
raw `XIC(main_xy_move.IP)EQU(STATE_REQUEST,14)MOV(14,NEXTSTATE)`

# PENDING EDIT in Studio
raw `XIC(main_xy_move.IP)XIO(ALL_EOT_GOOD)OSR(auto_edge_0_sb,eot_triggered)`

# PENDING EDIT in Studio
raw `XIC(eot_triggered)MCS(X_Y,xy_eot_stop_control,All,Yes,10000,Units per sec2,Yes,1000,Units per sec3)`

# PENDING EDIT in Studio
raw `XIC(eot_triggered)MOV(11,NEXTSTATE)`

# PENDING EDIT in Studio
raw `XIC(eot_triggered)MOV(0,STATE_REQUEST)`

# PENDING EDIT in Studio
raw `XIC(main_xy_move_completed)MOV(1,NEXTSTATE)MOV(0,MOVE_TYPE)MOV(0,STATE_REQUEST)MOV(0,main_xy_move.FLAGS)`
