<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="33.00" TargetName="main" TargetType="Routine" TargetSubType="RLL" TargetClass="Standard" ContainsContext="true" ExportDate="Fri Jun 12 14:10:57 2026" ExportOptions="References NoRawData L5KData DecoratedData Context Dependencies ForceProtectedEncoding AllProjDocTrans">
<Controller Use="Context" Name="DUNEW2PLC1">
<Programs Use="Context">
<Program Use="Context" Name="state_3_move_xy" Class="Standard">
<Routines Use="Context">
<Routine Use="Target" Name="main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[CMP(STATE=2)CPT(NEXTSTATE,1);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIO(main_xy_move.IP)CMP(STATE=3)[XIC(tension_stable_timer.DN) ,XIO(check_tension_stable) ,XIO(TENSION_CONTROL_OK) ][[XIO(Z_RETRACTED) ,GEQ(Z_axis.ActualPosition,MAX_TOLERABLE_Z) ] CPT(ERROR_CODE,3001) CPT(NEXTSTATE,10) ,XIC(Z_RETRACTED) [XIC(APA_IS_VERTICAL) ,XIO(APA_IS_VERTICAL) CPT(ERROR_CODE,3005) CPT(NEXTSTATE,10) ] OTE(STATE3_IND) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(STATE3_IND)[OSR(move_xy_entry_sb,move_xy_entry_ob) ,[XIC(X_Y.PhysicalAxisFault) CPT(ERROR_CODE,3002) ,[XIC(X_axis.SafeTorqueOffInhibit) ,XIC(Y_axis.SafeTorqueOffInhibit) ] CPT(ERROR_CODE,3004) ] CPT(NEXTSTATE,10) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(move_xy_entry_ob)[MSO(X_axis,x_axis_mso) ,MSO(Y_axis,y_axis_mso) ,MSO(Z_axis,z_axis_mso) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(z_axis_mso.DN)MOV(0,z_axis_pre_xy_retract.FLAGS)MAM(Z_axis,z_axis_pre_xy_retract,0,0,1000,Units per sec,10000,Units per sec2,10000,Units per sec2,S-Curve,10000,10000,Units per sec3,0,0,0,0,0,0)MOV(0,z_axis_mso.FLAGS);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(x_axis_mso.DN)XIC(y_axis_mso.DN)OSR(xy_axes_servoed_on_sb,xy_axes_servoed_on_ob);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[XIC(xy_axes_servoed_on_ob) ,XIC(x_axis_mso.DN) XIC(y_axis_mso.DN) XIC(move_xy_entry_ob) ]OSR(xy_move_trigger_sb,trigger_xy_move);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(trigger_xy_move)MOV(X_axis.ActualPosition,starting_x)MOV(Y_axis.ActualPosition,starting_y);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(trigger_xy_move)CPT(dx,ABS(starting_x-X_POSITION))CPT(dy,ABS(starting_y-Y_POSITION))CPT(x_time,v_x_max/dx)CPT(y_time,v_y_max/dy)[LES(x_time,y_time) CPT(k,x_time) ,LEQ(y_time,x_time) CPT(k,y_time) ]CPT(v_max,k*SQR(dx*dx+dy*dy))[LES(v_max,XY_SPEED) CPT(XY_SPEED_REQ,v_max) ,LEQ(XY_SPEED,v_max) CPT(XY_SPEED_REQ,XY_SPEED) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[CPT(x_dist_to_target,X_axis.ActualPosition-X_POSITION)CPT(y_dist_to_target,Y_axis.ActualPosition-Y_POSITION)CPT(xy_dist_to_target,SQR(x_dist_to_target*x_dist_to_target+y_dist_to_target*y_dist_to_target));]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[MOV(xy_decel_jerk,J)MOV(v_xyz,v_0)CPT(gamma,SQR(accel_xy*accel_xy+4*J*v_0))CPT(stopping_distance,(accel_xy+gamma)*(accel_xy+gamma)*(accel_xy+gamma)/(6*J*J));]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[CMP(xy_dist_to_target<stopping_distance*1)OTE(near_ending);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(STATE3_IND)CPT(stopping_ratio,stopping_distance/xy_dist_to_target);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[[XIC(TENSION_CONTROL_OK) XIC(speed_regulator_switch) JSR(xy_speed_regulator,0) ,[XIO(TENSION_CONTROL_OK) ,XIC(TENSION_CONTROL_OK) XIO(speed_regulator_switch) ] XIC(trigger_xy_move) MCLM(X_Y,main_xy_move,0,X_POSITION,XY_SPEED_REQ,Units per sec,XY_ACCELERATION,Units per sec2,XY_DECELERATION,Units per sec2,S-Curve,500,500,Units per sec3,0,Disabled,Programmed,50,0,None,0,0) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(speed_regulator_switch)OSF(speed_regulator_off_sb,speed_regulator_off_ob);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(speed_regulator_off_ob)XIO(near_ending)MCCD(X_Y,MCCD_X_Y_Axis1,Coordinated Move,Yes,XY_SPEED_REQ,Units per sec,Yes,XY_ACCELERATION,Units per sec2,Yes,XY_DECELERATION,Units per sec2,No,xy_accel_jerk,No,xy_decel_jerk,Units per sec3,Active Motion);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[[XIC(main_xy_move.PC) ,XIC(main_xy_move.ER) CMP((X_POSITION-X_axis.ActualPosition)<0.1) CMP((Y_POSITION-Y_axis.ActualPosition)<0.1) ]OSR(main_xy_move_completed_sb,main_xy_move_completed);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(main_xy_move.ER)CMP((X_POSITION-X_axis.ActualPosition)>0.1)CMP((Y_POSITION-Y_axis.ActualPosition)>0.1)CPT(ERROR_CODE,3005)CPT(NEXTSTATE,10)CPT(MOVE_TYPE,0)CPT(STATE_REQUEST,0)MOV(0,main_xy_move.FLAGS);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[XIC(main_xy_move.ER)OSR(xy_move_error_sb,xy_move_error_ob);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[XIC(main_xy_move.IP)CMP(STATE_REQUEST=14)CPT(NEXTSTATE,14);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[XIC(main_xy_move.IP)XIO(ALL_EOT_GOOD)OSR(xy_eot_trigger_sb,eot_triggered);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[XIC(eot_triggered)MCS(X_Y,xy_eot_stop_control,All,Yes,10000,Units per sec2,Yes,1000,Units per sec3)CPT(NEXTSTATE,11)CPT(STATE_REQUEST,0);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[XIC(main_xy_move_completed)CPT(NEXTSTATE,1)CPT(MOVE_TYPE,0)CPT(STATE_REQUEST,0)MOV(0,main_xy_move.FLAGS);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Use="Reference" Name="xy_speed_regulator">
</Routine>
</Routines>
</Program>
</Programs>
</Controller>
</RSLogix5000Content>
