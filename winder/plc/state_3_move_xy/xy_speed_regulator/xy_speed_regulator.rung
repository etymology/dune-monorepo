routine state_3_move_xy/xy_speed_regulator

uses tension, X_POSITION, X_Y, xy_regulated_acceleration, xy_regulated_deceleration  # controller scope
uses d_raw, main_xy_move, max_integral, min_integral, min_regulated_speed, regulated_speed  # program scope
uses regulator_loop_timer, speed_tension_setpoint, trigger_xy_move, v_max, xy_d_alpha, xy_d_dt  # program scope
uses xy_d_term, xy_d_term_prev, xy_d_timer, xy_decel_jerk, xy_default_speed, xy_dt, xy_error  # program scope
uses xy_error_prev, xy_i_term, xy_kd, xy_ki, xy_kp, xy_p_term, xy_regulated_accel_jerk  # program scope

# PENDING EDIT in Studio
raw `XIC(trigger_xy_move)MCLM(X_Y,main_xy_move,0,X_POSITION,v_max,Units per sec,xy_regulated_acceleration,Units per sec2,xy_regulated_deceleration,Units per sec2,S-Curve,xy_regulated_accel_jerk,xy_decel_jerk,Units per sec3,0,Disabled,Programmed,50,0,None,0,0)`

# PENDING EDIT in Studio
raw `XIC(trigger_xy_move)MOV(xy_dt,regulator_loop_timer.PRE)MOV(xy_d_dt,xy_d_timer.PRE)MOV(0,xy_i_term)`

# PENDING EDIT in Studio
raw `XIO(regulator_loop_timer.DN)TON(regulator_loop_timer,1,0)`

# PENDING EDIT in Studio
raw `XIO(xy_d_timer.DN)TON(xy_d_timer,50,48)`

# PENDING EDIT in Studio
raw `XIC(xy_d_timer.DN)CPT(d_raw,xy_kd*(xy_error-xy_error_prev)/xy_d_dt*100)CPT(xy_d_term,xy_d_alpha*d_raw+(1-xy_d_alpha)*xy_d_term_prev)MOV(xy_error,xy_error_prev)MOV(xy_d_term,xy_d_term_prev)`

# PENDING EDIT in Studio
raw `CPT(xy_error,speed_tension_setpoint-tension)`

# PENDING EDIT in Studio
raw `XIC(regulator_loop_timer.DN)CPT(xy_p_term,xy_kp*xy_error)`

# PENDING EDIT in Studio
raw `XIC(regulator_loop_timer.DN)[LES(regulated_speed,v_max),LES(xy_error,0)][GRT(regulated_speed,min_regulated_speed),GRT(xy_error,0)]CPT(xy_i_term,xy_i_term+(xy_ki*xy_error*xy_dt/1000))[LES(xy_i_term,min_integral)MOV(min_integral,xy_i_term),GRT(xy_i_term,max_integral)MOV(max_integral,xy_i_term)]`

# PENDING EDIT in Studio
raw `XIC(regulator_loop_timer.DN)CPT(regulated_speed,xy_default_speed+xy_p_term+xy_i_term+xy_d_term)[LES(v_max,regulated_speed)MOV(v_max,regulated_speed),LES(regulated_speed,min_regulated_speed)MOV(min_regulated_speed,regulated_speed)]`
