routine state_3_move_xy/xy_speed_regulator

uses tension, X_POSITION, X_Y, xy_regulated_acceleration, xy_regulated_deceleration  # controller scope
uses d_raw, main_xy_move, max_integral, min_integral, min_regulated_speed, regulated_speed  # program scope
uses regulator_loop_timer, speed_tension_setpoint, trigger_xy_move, v_max, xy_d_alpha, xy_d_dt  # program scope
uses xy_d_term, xy_d_term_prev, xy_d_timer, xy_decel_jerk, xy_default_speed, xy_dt, xy_error  # program scope
uses xy_error_prev, xy_i_term, xy_kd, xy_ki, xy_kp, xy_p_term, xy_regulated_accel_jerk  # program scope

when trigger_xy_move:
    coordinated_move X_Y using main_xy_move:
        type        = absolute
        target      = X_POSITION
        speed       = v_max units/s
        accel       = xy_regulated_acceleration units/s2
        decel       = xy_regulated_deceleration units/s2
        profile     = s-curve
        accel_jerk  = xy_regulated_accel_jerk
        decel_jerk  = xy_decel_jerk
        termination = programmed

when trigger_xy_move:
    regulator_loop_timer.PRE = xy_dt
    xy_d_timer.PRE = xy_d_dt
    xy_i_term = 0

start_timer regulator_loop_timer when not regulator_loop_timer.DN  # preset 1 ms

start_timer xy_d_timer when not xy_d_timer.DN  # preset 50 ms

when xy_d_timer.DN:
    d_raw = xy_kd * (xy_error - xy_error_prev) / xy_d_dt * 100
    xy_d_term = xy_d_alpha * d_raw + (1 - xy_d_alpha) * xy_d_term_prev
    xy_error_prev = xy_error
    xy_d_term_prev = xy_d_term

xy_error = speed_tension_setpoint - tension

xy_p_term = xy_kp * xy_error when regulator_loop_timer.DN

xy_i_term = xy_i_term + xy_ki * xy_error * xy_dt / 1000 when regulator_loop_timer.DN and (regulated_speed < v_max or xy_error < 0) and (regulated_speed > min_regulated_speed or xy_error > 0)

xy_i_term = min_integral when regulator_loop_timer.DN and (regulated_speed < v_max or xy_error < 0) and (regulated_speed > min_regulated_speed or xy_error > 0) and xy_i_term < min_integral

xy_i_term = max_integral when regulator_loop_timer.DN and (regulated_speed < v_max or xy_error < 0) and (regulated_speed > min_regulated_speed or xy_error > 0) and xy_i_term > max_integral

regulated_speed = xy_default_speed + xy_p_term + xy_i_term + xy_d_term when regulator_loop_timer.DN

regulated_speed = v_max when regulator_loop_timer.DN and v_max < regulated_speed

regulated_speed = min_regulated_speed when regulator_loop_timer.DN and regulated_speed < min_regulated_speed
