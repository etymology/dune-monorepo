routine state_10_error/main

uses ERROR_CODE, INIT_DONE, NEXTSTATE, STATE, STATE_REQUEST, X_axis, X_Y, Y_axis, Z_axis  # controller scope
uses error_axes_stopped_ob, error_axes_stopped_sb, error_entry_ob, error_entry_sb  # program scope
uses error_servo_off, error_servoed_off_ob, error_servoed_off_sb, STATE10_IND, x_axis_mafr  # program scope
uses x_axis_msf, xy_error_stop_control, y_axis_mafr, y_axis_msf, z_axis_error_stop_control  # program scope
uses z_axis_mafr, z_axis_msf  # program scope

# PENDING EDIT in Studio
raw `XIC(INIT_DONE)CMP(STATE=10)OTE(STATE10_IND)`

# PENDING EDIT in Studio
raw `XIC(STATE10_IND)OSR(error_entry_sb,error_entry_ob)`

# PENDING EDIT in Studio
raw `XIC(error_entry_ob)MOV(-1,STATE_REQUEST)`

# PENDING EDIT in Studio
raw `XIC(error_entry_ob)MCS(X_Y,xy_error_stop_control,All,Yes,1000,Units per sec2,Yes,1000,Units per sec3)`

# PENDING EDIT in Studio
raw `XIC(error_entry_ob)MAS(Z_axis,z_axis_error_stop_control,All,Yes,1000,Units per sec2,No,10000,% of Time)`

# PENDING EDIT in Studio
raw `XIC(xy_error_stop_control.PC)XIC(z_axis_error_stop_control.PC)OSR(error_axes_stopped_sb,error_axes_stopped_ob)`

# PENDING EDIT in Studio
raw `XIC(error_axes_stopped_ob)XIC(error_servo_off)MSF(X_axis,x_axis_msf)`

# PENDING EDIT in Studio
raw `XIC(error_axes_stopped_ob)XIC(error_servo_off)MSF(Y_axis,y_axis_msf)`

# PENDING EDIT in Studio
raw `XIC(error_axes_stopped_ob)XIC(error_servo_off)MSF(Z_axis,z_axis_msf)`

# PENDING EDIT in Studio
raw `XIC(x_axis_msf.DN)XIC(y_axis_msf.DN)XIC(z_axis_msf.DN)CMP(STATE_REQUEST=0)OSR(error_servoed_off_sb,error_servoed_off_ob)`

# PENDING EDIT in Studio
raw `XIC(error_servoed_off_ob)MAFR(Z_axis,z_axis_mafr)`

# PENDING EDIT in Studio
raw `XIC(z_axis_mafr.DN)MAFR(Y_axis,y_axis_mafr)`

# PENDING EDIT in Studio
raw `XIC(y_axis_mafr.DN)MAFR(X_axis,x_axis_mafr)`

# PENDING EDIT in Studio
raw `XIC(z_axis_msf.DN)XIC(y_axis_msf.DN)XIC(x_axis_msf.DN)CMP(STATE_REQUEST=0)CMP(STATE=10)CPT(ERROR_CODE,0)CPT(NEXTSTATE,1)`

# PENDING EDIT in Studio
raw `CMP(STATE=10)CMP(STATE_REQUEST=0)CPT(ERROR_CODE,0)CPT(NEXTSTATE,1)`
