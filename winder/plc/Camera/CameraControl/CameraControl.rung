routine Camera/CameraControl

uses CAM_F_EN, CAM_F_TRIGGER, EN_POS_TRIGGERS, FIFO_Data, FIFO_FLUSH, READ_FIFOS, X_axis  # controller scope
uses X_DELTA, Y_axis, Y_DELTA  # controller scope
uses Cam_F_InspectionRes_0, Cam_F_InspectionRes_1, Cam_F_InspectionRes_2, Cam_F_InspectionRes_3  # program scope
uses FIFO_CTRL, foundIt, LightRing, Manual_Trig, osob, ossb, Pos_trigger, RegistrationData  # program scope
uses triggerOneShotOB, triggerOneShotSB, TriggerResetTimer1, TriggerResetTimer2  # program scope
uses X_axis_Cam_F_Pos, X_axis_Cam_F_Position, x_pos, x_pos_next, Y_axis_Cam_F_Pos  # program scope
uses Y_axis_Cam_F_Position, y_pos, y_pos_next  # program scope
uses DUNE2CAM1:I, DUNE2CAM1:O  # module I/O

# PENDING EDIT in Studio
raw `XIC(CAM_F_EN)OTE(DUNE2CAM1:O.Control.TriggerEnable)`

# PENDING EDIT in Studio
raw `XIC(CAM_F_TRIGGER)OSR(triggerOneShotSB,triggerOneShotOB)`

# PENDING EDIT in Studio
raw `XIC(CAM_F_TRIGGER)XIC(triggerOneShotSB)XIO(TriggerResetTimer2.TT)TON(TriggerResetTimer1,100,5)`

# PENDING EDIT in Studio
raw `XIC(CAM_F_TRIGGER)XIC(triggerOneShotSB)XIO(TriggerResetTimer1.TT)TON(TriggerResetTimer2,100,0)`

# PENDING EDIT in Studio
raw `[XIC(TriggerResetTimer1.TT),XIC(LightRing.TT)]OTE(DUNE2CAM1:O.Control.Trigger)`

# PENDING EDIT in Studio
raw `[XIC(TriggerResetTimer1.TT),XIC(LightRing.TT)]MAR(Y_axis,RegistrationData[1],Negative_Edge,Disabled,0,0,2)`

# PENDING EDIT in Studio
raw `[XIC(TriggerResetTimer1.TT),XIC(LightRing.TT)]MAR(X_axis,RegistrationData[0],Negative_Edge,Disabled,0,0,2)`

# PENDING EDIT in Studio
raw `XIC(RegistrationData[0].PC)CPT(X_axis_Cam_F_Position,X_axis.Registration2NegativeEdgePosition)`

# PENDING EDIT in Studio
raw `XIC(RegistrationData[1].PC)CPT(Y_axis_Cam_F_Position,Y_axis.Registration2NegativeEdgePosition)`

# PENDING EDIT in Studio
raw `XIC(RegistrationData[0].PC)FFL(X_axis_Cam_F_Position,X_axis_Cam_F_Pos[0],FIFO_CTRL[0],?,?)`

# PENDING EDIT in Studio
raw `XIC(RegistrationData[1].PC)FFL(Y_axis_Cam_F_Position,Y_axis_Cam_F_Pos[0],FIFO_CTRL[1],?,?)`

# PENDING EDIT in Studio
raw `XIC(DUNE2CAM1:I.Status.InspectionCompleted)OSR(ossb[3],osob[3])`

# PENDING EDIT in Studio
raw `XIC(RegistrationData[1].PC)FFL(DUNE2CAM1:I.InspectionResults[0],Cam_F_InspectionRes_0[0],FIFO_CTRL[2],?,?)`

# PENDING EDIT in Studio
raw `XIC(RegistrationData[1].PC)FFL(DUNE2CAM1:I.InspectionResults[1],Cam_F_InspectionRes_1[0],FIFO_CTRL[3],?,?)`

# PENDING EDIT in Studio
raw `XIC(RegistrationData[1].PC)FFL(DUNE2CAM1:I.InspectionResults[2],Cam_F_InspectionRes_2[0],FIFO_CTRL[4],?,?)`

# PENDING EDIT in Studio
raw `XIC(RegistrationData[1].PC)FFL(DUNE2CAM1:I.InspectionResults[3],Cam_F_InspectionRes_3[0],FIFO_CTRL[5],?,?)`

# PENDING EDIT in Studio
raw `XIC(FIFO_CTRL[5].DN)OTL(READ_FIFOS)`

# PENDING EDIT in Studio
raw `XIC(READ_FIFOS)FFU(X_axis_Cam_F_Pos[0],FIFO_Data[0],FIFO_CTRL[0],?,?)`

# PENDING EDIT in Studio
raw `XIC(FIFO_CTRL[0].EU)FFU(Y_axis_Cam_F_Pos[0],FIFO_Data[1],FIFO_CTRL[1],?,?)`

# PENDING EDIT in Studio
raw `XIC(FIFO_CTRL[1].EU)FFU(Cam_F_InspectionRes_0[0],FIFO_Data[2],FIFO_CTRL[2],?,?)`

# PENDING EDIT in Studio
raw `XIC(FIFO_CTRL[2].EU)FFU(Cam_F_InspectionRes_1[0],FIFO_Data[3],FIFO_CTRL[3],?,?)`

# PENDING EDIT in Studio
raw `XIC(FIFO_CTRL[3].EU)FFU(Cam_F_InspectionRes_2[0],FIFO_Data[4],FIFO_CTRL[4],?,?)`

# PENDING EDIT in Studio
raw `XIC(FIFO_CTRL[4].EU)FFU(Cam_F_InspectionRes_3[0],FIFO_Data[5],FIFO_CTRL[5],?,?)`

# PENDING EDIT in Studio
raw `XIC(FIFO_CTRL[5].EU)OTU(READ_FIFOS)`

# PENDING EDIT in Studio
raw `XIC(EN_POS_TRIGGERS)OSR(ossb[1],osob[1])`

# PENDING EDIT in Studio
raw `XIC(osob[1])CPT(x_pos,X_axis.ActualPosition)`

# PENDING EDIT in Studio
raw `XIC(osob[1])CPT(y_pos,Y_axis.ActualPosition)`

# PENDING EDIT in Studio
raw `XIC(osob[1])OTL(Pos_trigger)`

# PENDING EDIT in Studio
raw `XIC(EN_POS_TRIGGERS)XIC(Pos_trigger)[[CMP(X_DELTA<0)CMP(X_axis.ActualPosition<(x_pos+X_DELTA)),CMP(X_DELTA>0)CMP(X_axis.ActualPosition>(x_pos+X_DELTA))],[CMP(Y_DELTA<0)CMP(Y_axis.ActualPosition<(y_pos+Y_DELTA)),CMP(Y_DELTA>0)CMP(Y_axis.ActualPosition>(y_pos+Y_DELTA))]]OTL(foundIt)`

# PENDING EDIT in Studio
raw `XIC(EN_POS_TRIGGERS)[XIC(foundIt),XIC(Manual_Trig)]OSR(ossb[0],osob[0])OTU(Pos_trigger)`

# PENDING EDIT in Studio
raw `XIC(EN_POS_TRIGGERS)XIC(osob[0])CPT(x_pos_next,x_pos+X_DELTA)`

# PENDING EDIT in Studio
raw `XIC(EN_POS_TRIGGERS)XIC(osob[0])CPT(y_pos_next,y_pos+Y_DELTA)`

# PENDING EDIT in Studio
raw `XIC(EN_POS_TRIGGERS)XIC(ossb[0])TON(LightRing,100,0)`

# PENDING EDIT in Studio
raw `XIC(EN_POS_TRIGGERS)XIC(LightRing.DN)OTU(foundIt)`

# PENDING EDIT in Studio
raw `XIC(EN_POS_TRIGGERS)XIC(LightRing.DN)[CMP(x_pos_next<>x_pos),CMP(y_pos_next<>y_pos)]CPT(x_pos,x_pos_next)CPT(y_pos,y_pos_next)OTL(Pos_trigger)`

# PENDING EDIT in Studio
raw `XIC(FIFO_FLUSH)MOV(0,FIFO_CTRL[0].POS)MOV(0,FIFO_CTRL[1].POS)MOV(0,FIFO_CTRL[2].POS)MOV(0,FIFO_CTRL[3].POS)MOV(0,FIFO_CTRL[4].POS)MOV(0,FIFO_CTRL[5].POS)OTU(FIFO_FLUSH)`
