routine Camera/CameraControl

uses CAM_F_EN, CAM_F_TRIGGER, EN_POS_TRIGGERS, FIFO_Data, FIFO_FLUSH, READ_FIFOS, X_axis  # controller scope
uses X_DELTA, Y_axis, Y_DELTA  # controller scope
uses Cam_F_InspectionRes_0, Cam_F_InspectionRes_1, Cam_F_InspectionRes_2, Cam_F_InspectionRes_3  # program scope
uses FIFO_CTRL, foundIt, LightRing, Manual_Trig, osob, ossb, Pos_trigger, RegistrationData  # program scope
uses triggerOneShotOB, triggerOneShotSB, TriggerResetTimer1, TriggerResetTimer2  # program scope
uses X_axis_Cam_F_Pos, X_axis_Cam_F_Position, x_pos, x_pos_next, Y_axis_Cam_F_Pos  # program scope
uses Y_axis_Cam_F_Position, y_pos, y_pos_next  # program scope
uses DUNE2CAM1:I, DUNE2CAM1:O  # module I/O

DUNE2CAM1:O.Control.TriggerEnable = CAM_F_EN

OSR(triggerOneShotSB, triggerOneShotOB) when CAM_F_TRIGGER

start_timer TriggerResetTimer1 when CAM_F_TRIGGER and triggerOneShotSB and not TriggerResetTimer2.TT  # preset 100 ms

start_timer TriggerResetTimer2 when CAM_F_TRIGGER and triggerOneShotSB and not TriggerResetTimer1.TT  # preset 100 ms

DUNE2CAM1:O.Control.Trigger = TriggerResetTimer1.TT or LightRing.TT

MAR(Y_axis, RegistrationData[1], Negative_Edge, Disabled, 0, 0, 2) when TriggerResetTimer1.TT or LightRing.TT

MAR(X_axis, RegistrationData[0], Negative_Edge, Disabled, 0, 0, 2) when TriggerResetTimer1.TT or LightRing.TT

X_axis_Cam_F_Position = X_axis.Registration2NegativeEdgePosition when RegistrationData[0].PC

Y_axis_Cam_F_Position = Y_axis.Registration2NegativeEdgePosition when RegistrationData[1].PC

FFL(X_axis_Cam_F_Position, X_axis_Cam_F_Pos[0], FIFO_CTRL[0], ?, ?) when RegistrationData[0].PC

FFL(Y_axis_Cam_F_Position, Y_axis_Cam_F_Pos[0], FIFO_CTRL[1], ?, ?) when RegistrationData[1].PC

OSR(ossb[3], osob[3]) when DUNE2CAM1:I.Status.InspectionCompleted

FFL(DUNE2CAM1:I.InspectionResults[0], Cam_F_InspectionRes_0[0], FIFO_CTRL[2], ?, ?) when RegistrationData[1].PC

FFL(DUNE2CAM1:I.InspectionResults[1], Cam_F_InspectionRes_1[0], FIFO_CTRL[3], ?, ?) when RegistrationData[1].PC

FFL(DUNE2CAM1:I.InspectionResults[2], Cam_F_InspectionRes_2[0], FIFO_CTRL[4], ?, ?) when RegistrationData[1].PC

FFL(DUNE2CAM1:I.InspectionResults[3], Cam_F_InspectionRes_3[0], FIFO_CTRL[5], ?, ?) when RegistrationData[1].PC

latch READ_FIFOS when FIFO_CTRL[5].DN

FFU(X_axis_Cam_F_Pos[0], FIFO_Data[0], FIFO_CTRL[0], ?, ?) when READ_FIFOS

FFU(Y_axis_Cam_F_Pos[0], FIFO_Data[1], FIFO_CTRL[1], ?, ?) when FIFO_CTRL[0].EU

FFU(Cam_F_InspectionRes_0[0], FIFO_Data[2], FIFO_CTRL[2], ?, ?) when FIFO_CTRL[1].EU

FFU(Cam_F_InspectionRes_1[0], FIFO_Data[3], FIFO_CTRL[3], ?, ?) when FIFO_CTRL[2].EU

FFU(Cam_F_InspectionRes_2[0], FIFO_Data[4], FIFO_CTRL[4], ?, ?) when FIFO_CTRL[3].EU

FFU(Cam_F_InspectionRes_3[0], FIFO_Data[5], FIFO_CTRL[5], ?, ?) when FIFO_CTRL[4].EU

unlatch READ_FIFOS when FIFO_CTRL[5].EU

on rising EN_POS_TRIGGERS:
    x_pos = X_axis.ActualPosition
    y_pos = Y_axis.ActualPosition
    latch Pos_trigger

latch foundIt when EN_POS_TRIGGERS and Pos_trigger and (X_DELTA < 0 and X_axis.ActualPosition < x_pos + X_DELTA or X_DELTA > 0 and X_axis.ActualPosition > x_pos + X_DELTA or Y_DELTA < 0 and Y_axis.ActualPosition < y_pos + Y_DELTA or Y_DELTA > 0 and Y_axis.ActualPosition > y_pos + Y_DELTA)

when EN_POS_TRIGGERS and (foundIt or Manual_Trig):
    OSR(ossb[0], osob[0])
    unlatch Pos_trigger

x_pos_next = x_pos + X_DELTA when EN_POS_TRIGGERS and osob[0]

y_pos_next = y_pos + Y_DELTA when EN_POS_TRIGGERS and osob[0]

start_timer LightRing when EN_POS_TRIGGERS and ossb[0]  # preset 100 ms

unlatch foundIt when EN_POS_TRIGGERS and LightRing.DN

raw `XIC(EN_POS_TRIGGERS)XIC(LightRing.DN)[CMP(x_pos_next<>x_pos),CMP(y_pos_next<>y_pos)]CPT(x_pos,x_pos_next)CPT(y_pos,y_pos_next)OTL(Pos_trigger)`

when FIFO_FLUSH:
    FIFO_CTRL[0].POS = 0
    FIFO_CTRL[1].POS = 0
    FIFO_CTRL[2].POS = 0
    FIFO_CTRL[3].POS = 0
    FIFO_CTRL[4].POS = 0
    FIFO_CTRL[5].POS = 0
    unlatch FIFO_FLUSH
