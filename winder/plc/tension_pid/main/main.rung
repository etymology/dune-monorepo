routine tension_pid/main

uses current_command, current_command_high, current_command_low, ERROR_CODE  # controller scope
uses max_tolerable_tension, MORE_STATS, neutral_cv, NEXTSTATE, overtension_timer  # controller scope
uses pid_cv_high_limit, pid_cv_low_limit, PID_LOOP_TIMER, Safety_Tripped_S, tension  # controller scope
uses TENSION_CONTROL_OK, tension_motor_curr_override, tension_motor_cv, tension_off_oneshot  # controller scope
uses tension_on_oneshot, TENSION_ON_SWITCH, tension_on_switch_delay_on_start, tension_setpoint  # controller scope
uses tension_stable_timer, tension_tag, winding_head_pid, wire_broken_tension, wire_tensioned  # controller scope
uses a0, a1, a2, a3, a4, constant_cv_out, cv_to_electrocraft, disable_motor  # program scope
uses Enable_tension_motor, oneshotsb, ramp_start_cv, tension_off_ramp_timer, tension_stable_time  # program scope
uses tension_stable_tolerance, wire_broken_state, wire_undertension_debounce  # program scope
uses Local:1:I, Local:3:O  # module I/O

when TENSION_ON_SWITCH:
    start_timer tension_on_switch_delay_on_start  # preset 500 ms
    OSR(oneshotsb[0], tension_on_oneshot)
    OSF(oneshotsb[1], tension_off_oneshot)

ramp_start_cv = tension_motor_cv when tension_off_oneshot

unlatch wire_broken_state when tension_on_oneshot

unlatch wire_broken_state when tension_off_oneshot

start_timer tension_off_ramp_timer when not TENSION_ON_SWITCH  # preset 500 ms

start_timer wire_undertension_debounce when not wire_tensioned  # preset 20 ms

TENSION_CONTROL_OK = tension_on_switch_delay_on_start.TT or not wire_undertension_debounce.DN

Enable_tension_motor = (TENSION_CONTROL_OK or tension_off_ramp_timer.TT or constant_cv_out) and not Safety_Tripped_S and disable_motor and not wire_broken_state

start_timer PID_LOOP_TIMER when not PID_LOOP_TIMER.DN  # preset 3 ms

tension = a0 + a1 * tension_tag + a2 * tension_tag * tension_tag + a3 * tension_tag * tension_tag * tension_tag + a4 * tension_tag * tension_tag * tension_tag * tension_tag

winding_head_pid.SP = tension_setpoint when TENSION_CONTROL_OK

PID(winding_head_pid, tension, 0, tension_motor_cv, 0, 0, 0) when PID_LOOP_TIMER.DN

when not TENSION_CONTROL_OK or not TENSION_ON_SWITCH:
    tension_motor_cv = neutral_cv
    winding_head_pid.DATA[0] = 0

tension_motor_cv = neutral_cv when tension_on_switch_delay_on_start.TT and tension_motor_cv < neutral_cv

tension_motor_cv = ramp_start_cv + (neutral_cv - ramp_start_cv) * tension_off_ramp_timer.ACC / tension_off_ramp_timer.PRE when tension_off_ramp_timer.TT

tension_motor_cv = tension_motor_curr_override when constant_cv_out

cv_to_electrocraft = tension_motor_cv

current_command = cv_to_electrocraft * (current_command_high - current_command_low) / pid_cv_high_limit + current_command_low

neutral_cv = -current_command_low / ((current_command_high - current_command_low) / (pid_cv_high_limit - pid_cv_low_limit))

tension_stable_timer.PRE = tension_stable_time

start_timer tension_stable_timer when abs(tension - tension_setpoint) < tension_stable_tolerance  # preset 10 ms

Local:3:O.Pt15.Data = tension > max_tolerable_tension and TENSION_ON_SWITCH

start_timer overtension_timer when tension > max_tolerable_tension and TENSION_ON_SWITCH  # preset 25 ms

MORE_STATS[2] = overtension_timer.DN

when overtension_timer.DN:
    ERROR_CODE = 8002
    NEXTSTATE = 10

raw `XIC(tension_on_switch_delay_on_start.DN)XIC(wire_undertension_debounce.DN)NEQ(ERROR_CODE,8002)CPT(NEXTSTATE,10)CPT(ERROR_CODE,8001)OTL(wire_broken_state)`

wire_tensioned = Local:1:I.Pt15.Data or tension > wire_broken_tension

raw `XIO(TENSION_ON_SWITCH)[EQU(ERROR_CODE,8002),EQU(ERROR_CODE,8001)]CPT(ERROR_CODE,0)CPT(NEXTSTATE,1)`
