XIC TENSION_ON_SWITCH BST TON tension_on_switch_delay_on_start 1000 0 NXB OSR oneshotsb[0] tension_on_oneshot NXB OSF oneshotsb[1] tension_off_oneshot BND 
XIC tension_off_oneshot MOV tension_motor_cv ramp_start_cv 
XIC TENSION_ON_SWITCH TOF tension_off_ramp_timer ? ? 
XIO wire_break_proxy TON wire_break_debounce 20 20 
BST XIC TENSION_ON_SWITCH XIO Safety_Tripped_S BST XIC wire_break_proxy NXB XIC tension_on_switch_delay_on_start.TT NXB XIO wire_break_debounce.DN BND NXB XIC tension_off_ramp_timer.TT BND OTE Enable_tension_motor 
BST XIC tension_on_switch_delay_on_start.TT NXB XIC TENSION_CONTROL_OK BND BST BST XIC wire_break_proxy NXB XIO wire_break_switch_delay_on_start.DN NXB XIO wire_break_debounce.DN BND OTE TENSION_CONTROL_OK NXB TON wire_break_switch_delay_on_start 1000 0 BND 
XIO PID_LOOP_TIMER.DN TON PID_LOOP_TIMER 3 2 
CPT tension a0+a1*tension_tag+a2*tension_tag*tension_tag+a3*tension_tag*tension_tag*tension_tag+a4*tension_tag*tension_tag*tension_tag*tension_tag 
BST XIC PID_LOOP_TIMER.DN NXB XIC pid_loop_timer_bypass BND BST XIC TENSION_CONTROL_OK MOV tension_setpoint winding_head_pid.SP NXB XIO TENSION_CONTROL_OK MOV 10 tension MOV 0 winding_head_pid.SP NXB PID winding_head_pid tension 0 tension_motor_cv 0 0 0 NXB BST XIO TENSION_CONTROL_OK NXB XIO TENSION_ON_SWITCH NXB XIC tension_on_switch_delay_on_start.TT LES tension_motor_cv neutral_cv BND MOV neutral_cv tension_motor_cv NXB XIC tension_off_ramp_timer.TT CPT tension_motor_cv ramp_start_cv+(neutral_cv-ramp_start_cv)*tension_off_ramp_timer.ACC/tension_off_ramp_timer.PRE NXB XIC constant_cv_out MOV SetPoint_Override tension_motor_cv NXB MOV tension_motor_cv cv_to_electrocraft BND 
CPT tension_motor_difference tension-tension_motor_cv 
CPT current_command cv_to_electrocraft*(current_command_high-current_command_low)/pid_cv_high_limit+current_command_low 
CPT neutral_cv -current_command_low/((current_command_high-current_command_low)/(pid_cv_high_limit-pid_cv_low_limit)) 
MOV tension_stable_time tension_stable_timer.PRE CMP "ABS(tension-tension_setpoint)<tension_stable_tolerance" TON tension_stable_timer 10 0 
GRT tension max_tolerable_tension XIC TENSION_ON_SWITCH OTE Local:3:O.Pt15.Data TON overtension_timer 10 0 
XIC overtension_timer.DN OTE MORE_STATS[2] CPT ERROR_CODE 8002 CPT NEXTSTATE 10 
XIC tension_on_switch_delay_on_start.DN XIC wire_break_debounce.DN NEQ ERROR_CODE 8002 CPT NEXTSTATE 10 CPT ERROR_CODE 8001 
BST XIC Local:1:I.Pt15.Data NXB GRT tension_tag wire_broken_tension BND OTE wire_break_proxy 
XIO TENSION_ON_SWITCH BST EQU ERROR_CODE 8002 NXB EQU ERROR_CODE 8001 BND CPT ERROR_CODE 0 

