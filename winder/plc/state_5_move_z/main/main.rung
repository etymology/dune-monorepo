routine state_5_move_z/main

uses ACTUATOR_POS, ALL_EOT_GOOD, check_tension_stable, ERROR_CODE, FRAME_LOC_FT_BTM  # controller scope
uses FRAME_LOC_FT_MID, FRAME_LOC_FT_TOP, FRAME_LOC_HD_BTM, FRAME_LOC_HD_MID, FRAME_LOC_HD_TOP  # controller scope
uses LATCH_ACTUATOR_HOMED, MASTER_Z_GO, MOVE_TYPE, NEXTSTATE, no_apa_collision  # controller scope
uses no_latch_collision, no_supports_collision, STATE, STATE_REQUEST  # controller scope
uses support_collision_window_bttm, support_collision_window_mid, support_collision_window_top  # controller scope
uses TENSION_ON_SWITCH, tension_stable_timer, X_axis, X_XFER_OK, Y_XFER_OK, Z_ACCELERATION  # controller scope
uses Z_axis, Z_DECELLERATION, Z_FIXED_LATCHED, Z_POSITION, Z_SPEED  # controller scope
uses eot_stop, oneshotob, STATE5_IND, z_accel_jerk, z_axis_fast_move, z_axis_main_move  # program scope
uses z_axis_mso, z_decel_jerk, z_move_success  # program scope

# PENDING EDIT in Studio
raw `[XIC(Z_FIXED_LATCHED)EQU(ACTUATOR_POS,2),XIO(Z_FIXED_LATCHED)]OTE(no_latch_collision)`

# PENDING EDIT in Studio
raw `[XIC(X_XFER_OK),XIC(Y_XFER_OK)]OTE(no_apa_collision)`

# PENDING EDIT in Studio
raw `[XIC(X_XFER_OK)[LIM(400,X_axis.ActualPosition,500)[XIC(support_collision_window_bttm)XIO(FRAME_LOC_HD_BTM),XIC(support_collision_window_mid)XIO(FRAME_LOC_HD_MID),XIC(support_collision_window_top)XIO(FRAME_LOC_HD_TOP)],LIM(7100,X_axis.ActualPosition,7200)[XIC(support_collision_window_bttm)XIO(FRAME_LOC_FT_BTM),XIC(support_collision_window_mid)XIO(FRAME_LOC_FT_MID),XIC(support_collision_window_top)XIO(FRAME_LOC_FT_TOP)],XIO(support_collision_window_bttm)XIO(support_collision_window_mid)XIO(support_collision_window_top)],XIC(Y_XFER_OK)]OTE(no_supports_collision)`

# PENDING EDIT in Studio
raw `XIC(no_latch_collision)XIC(no_supports_collision)XIC(no_apa_collision)OTE(MASTER_Z_GO)`

# PENDING EDIT in Studio
raw `CMP(STATE=4)MOV(1,NEXTSTATE)`

# PENDING EDIT in Studio
raw `CMP(STATE=5)XIC(Z_FIXED_LATCHED)XIC(LATCH_ACTUATOR_HOMED)CMP(ACTUATOR_POS<>2)CPT(ERROR_CODE,5004)CPT(NEXTSTATE,10)`

# PENDING EDIT in Studio
raw `CMP(STATE=5)XIC(Z_axis.PhysicalAxisFault)CPT(ERROR_CODE,5002)CPT(NEXTSTATE,10)`

# PENDING EDIT in Studio
raw `CMP(STATE=5)XIO(MASTER_Z_GO)CPT(ERROR_CODE,5001)CPT(NEXTSTATE,10)`

# PENDING EDIT in Studio
raw `XIC(MASTER_Z_GO)CMP(ERROR_CODE=5001)CPT(ERROR_CODE,0)`

STATE5_IND = STATE == 5 and MASTER_Z_GO and (tension_stable_timer.DN or not check_tension_stable or not TENSION_ON_SWITCH or Z_FIXED_LATCHED)

# PENDING EDIT in Studio
raw `XIC(STATE5_IND)XIO(Z_axis.DriveEnableStatus)MSO(Z_axis,z_axis_mso)`

# PENDING EDIT in Studio
raw `XIC(STATE5_IND)XIC(Z_axis.DriveEnableStatus)XIO(Z_FIXED_LATCHED)MAM(Z_axis,z_axis_main_move,0,Z_POSITION,Z_SPEED,Units per sec,Z_ACCELERATION,Units per sec2,Z_DECELLERATION,Units per sec2,S-Curve,z_accel_jerk,z_decel_jerk,Units per sec3,Disabled,Programmed,0,None,0,0)`

# PENDING EDIT in Studio
raw `XIC(STATE5_IND)XIC(Z_axis.DriveEnableStatus)XIC(Z_FIXED_LATCHED)MAM(Z_axis,z_axis_fast_move,0,Z_POSITION,2000,Units per sec,10000,Units per sec2,10000,Units per sec2,S-Curve,10000,10000,Units per sec3,Disabled,Programmed,0,None,0,0)`

# PENDING EDIT in Studio
raw `XIC(Z_axis.MoveStatus)CMP(STATE_REQUEST=14)CPT(NEXTSTATE,14)`

# PENDING EDIT in Studio
raw `XIO(ALL_EOT_GOOD)XIC(Z_axis.MoveStatus)MAS(Z_axis,eot_stop,Jog,Yes,2000,Units per sec2,No,100,% of Time)`

# PENDING EDIT in Studio
raw `XIC(eot_stop.PC)CPT(ERROR_CODE,5005)CPT(NEXTSTATE,11)MOV(0,eot_stop.FLAGS)`

# PENDING EDIT in Studio
raw `CMP(STATE=5)CMP(ABS(Z_axis.ActualPosition-Z_POSITION)<0.1)OSR(oneshotob[0],z_move_success)`

# PENDING EDIT in Studio
raw `XIC(z_move_success)CPT(STATE_REQUEST,0)CPT(MOVE_TYPE,0)CPT(NEXTSTATE,1)MOV(0,z_axis_main_move.FLAGS)MOV(0,z_axis_fast_move.FLAGS)`
