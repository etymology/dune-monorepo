routine state_6_latch/main

uses ACTUATOR_POS, delay_mid_position, ENABLE_ACTUATOR, ERROR_CODE, LATCH_ACTUATOR_MID  # controller scope
uses LATCH_ACTUATOR_TOP, latching_in_progress, MACHINE_SW_STAT, MOVE_TYPE, NEXTSTATE, STATE  # controller scope
uses STATE_REQUEST, Z_EXTENDED, Z_FIXED_PRESENT, Z_RETRACTED, Z_STAGE_LATCHED, Z_STAGE_PRESENT  # controller scope
uses delay_stage_latched, head_between_stage_and_fixed, latch_in_free_space  # program scope
uses Latching_pulse_duration, Latching_pulse_interval, latching_rising_edge, latching_signal  # program scope
uses latching_storage_bit, LatchingTimeoutCounter, manual_toggle_latch, one_second_timer  # program scope
uses PREV_ACT_POS  # program scope
uses Local:1:I, Local:3:O  # module I/O

# PENDING EDIT in Studio
raw `XIO(Local:1:I.Pt08.Data)OTE(MACHINE_SW_STAT[12])OTE(LATCH_ACTUATOR_TOP)`

# PENDING EDIT in Studio
raw `XIO(Local:1:I.Pt09.Data)OTE(MACHINE_SW_STAT[13])OTE(LATCH_ACTUATOR_MID)`

# PENDING EDIT in Studio
raw `XIC(LATCH_ACTUATOR_TOP)XIO(LATCH_ACTUATOR_MID)CPT(ACTUATOR_POS,3)`

# PENDING EDIT in Studio
raw `XIC(LATCH_ACTUATOR_TOP)XIC(LATCH_ACTUATOR_MID)TON(delay_mid_position,200,0)`

# PENDING EDIT in Studio
raw `XIC(LATCH_ACTUATOR_TOP)XIC(LATCH_ACTUATOR_MID)XIC(delay_mid_position.DN)CPT(ACTUATOR_POS,2)`

# PENDING EDIT in Studio
raw `XIO(LATCH_ACTUATOR_TOP)XIO(LATCH_ACTUATOR_MID)XIO(Z_STAGE_LATCHED)CPT(ACTUATOR_POS,0)`

# PENDING EDIT in Studio
raw `XIC(Z_STAGE_LATCHED)TON(delay_stage_latched,150,0)`

# PENDING EDIT in Studio
raw `XIC(Z_STAGE_LATCHED)XIC(delay_stage_latched.DN)CPT(ACTUATOR_POS,1)`

# PENDING EDIT in Studio
raw `XIC(Z_STAGE_PRESENT)XIC(Z_FIXED_PRESENT)XIC(Z_EXTENDED)OTE(head_between_stage_and_fixed)`

# PENDING EDIT in Studio
raw `XIO(Z_STAGE_PRESENT)XIC(Z_RETRACTED)OTE(latch_in_free_space)`

# PENDING EDIT in Studio
raw `[XIC(head_between_stage_and_fixed),XIC(latch_in_free_space)]OTE(ENABLE_ACTUATOR)`

# PENDING EDIT in Studio
raw `CMP(STATE=6)XIC(ENABLE_ACTUATOR)OTE(latching_in_progress)`

# PENDING EDIT in Studio
raw `CMP(STATE=6)XIO(ENABLE_ACTUATOR)CPT(ERROR_CODE,6001)CPT(NEXTSTATE,10)`

# PENDING EDIT in Studio
raw `XIC(latching_in_progress)OSR(latching_storage_bit,latching_rising_edge)`

# PENDING EDIT in Studio
raw `XIC(latching_rising_edge)CPT(PREV_ACT_POS,ACTUATOR_POS)`

# PENDING EDIT in Studio
raw `XIC(latching_rising_edge)RES(LatchingTimeoutCounter)`

# PENDING EDIT in Studio
raw `XIC(latching_in_progress)XIC(Latching_pulse_interval.DN)TON(Latching_pulse_duration,25,0)`

# PENDING EDIT in Studio
raw `XIC(latching_in_progress)TON(Latching_pulse_interval,300,0)`

# PENDING EDIT in Studio
raw `XIC(latching_in_progress)XIC(Latching_pulse_duration.DN)RES(Latching_pulse_interval)`

# PENDING EDIT in Studio
raw `[XIC(Latching_pulse_duration.TT),XIC(manual_toggle_latch)]OTE(Local:3:O.Pt01.Data)OTE(latching_signal)`

# PENDING EDIT in Studio
raw `XIC(latching_in_progress)XIC(head_between_stage_and_fixed)[CMP(PREV_ACT_POS=1)CMP(ACTUATOR_POS=3),CMP(PREV_ACT_POS=3)CMP(ACTUATOR_POS=2),CMP(PREV_ACT_POS=2)CMP(ACTUATOR_POS=1),CMP(PREV_ACT_POS=0)CMP(ACTUATOR_POS<>0)]CPT(MOVE_TYPE,0)MOV(0,STATE_REQUEST)CPT(NEXTSTATE,1)`

# PENDING EDIT in Studio
raw `XIC(latching_in_progress)XIC(latch_in_free_space)[CMP(PREV_ACT_POS=0)CMP(ACTUATOR_POS=3),CMP(PREV_ACT_POS=3)CMP(ACTUATOR_POS=2),CMP(PREV_ACT_POS=2)CMP(ACTUATOR_POS=0)]CPT(MOVE_TYPE,0)MOV(0,STATE_REQUEST)CPT(NEXTSTATE,1)`

# PENDING EDIT in Studio
raw `XIC(latching_in_progress)XIO(LatchingTimeoutCounter.DN)TON(one_second_timer,1000,0)`

# PENDING EDIT in Studio
raw `XIC(latching_in_progress)XIO(LatchingTimeoutCounter.DN)XIC(one_second_timer.DN)RES(one_second_timer)CTU(LatchingTimeoutCounter,20,0)`

# PENDING EDIT in Studio
raw `XIC(LatchingTimeoutCounter.DN)XIC(latching_in_progress)CPT(ERROR_CODE,6002)CPT(NEXTSTATE,10)RES(LatchingTimeoutCounter)`
