routine state_14_hmi_stop/main

uses AbortQueue, CurIssued, NextIssued, NEXTSTATE, QueueCount, STATE, STATE_REQUEST, X_axis, X_Y  # controller scope
uses xz, Y_axis, Z_axis  # controller scope
uses hmi_x_axis_stop, hmi_xy_stop, hmi_xz_stop, hmi_y_axis_stop, hmi_z_axis_stop, STATE14_IND  # program scope

STATE14_IND = STATE == 14

on rising STATE14_IND:
    MCS(X_Y, hmi_xy_stop, All, Yes, 1200, "Units per sec2", Yes, 1200, "Units per sec3")
    MCS(xz, hmi_xz_stop, All, Yes, 1200, "Units per sec2", Yes, 1200, "Units per sec3")
    MAS(X_axis, hmi_x_axis_stop, All, Yes, 1200, "Units per sec2", Yes, 1200, "Units per sec3")
    MAS(Y_axis, hmi_y_axis_stop, All, Yes, 1200, "Units per sec2", Yes, 1200, "Units per sec3")
    MAS(Z_axis, hmi_z_axis_stop, All, Yes, 1200, "Units per sec2", Yes, 1200, "Units per sec3")

AbortQueue = STATE14_IND

STATE_REQUEST = 0 when STATE14_IND

NEXTSTATE = 1 when STATE14_IND and hmi_xy_stop.DN and hmi_xz_stop.DN and hmi_x_axis_stop.DN and hmi_y_axis_stop.DN and hmi_z_axis_stop.DN and not CurIssued and not NextIssued and not X_Y.MovePendingStatus and QueueCount <= 0
